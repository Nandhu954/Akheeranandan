<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera permission for QR scanning -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Declare camera hardware is optional to allow app install on devices without rear camera -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_campusfind_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_campusfind_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusFind"
        tools:targetApi="31">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- Main Dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Report Activities -->
        <activity
            android:name=".activities.ReportLostActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ReportFoundActivity"
            android:exported="false" />

        <!-- Search & Details -->
        <activity
            android:name=".activities.SearchActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ItemDetailActivity"
            android:exported="false" />

        <!-- User Reports -->
        <activity
            android:name=".activities.MyReportsActivity"
            android:exported="false" />

        <!-- QR Verification Scanner -->
        <activity
            android:name=".activities.ScanQRActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden" />

    </application>

</manifest>
